import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.stats import norm

# =====================================================================
# 1. VECTORIZED PRICING & GREEKS ENGINE
# =====================================================================

def vectorized_bs_greeks(S, K, T, r, sigma, option_type="call"):
    """
    Vectorized Black-Scholes pricer and Greek analytical engine.
    Supports scalar or NumPy array inputs for S and T.
    """
    T_safe = np.maximum(T, 1e-5)
    d1 = (np.log(S / K) + (r + 0.5 * sigma**2) * T_safe) / (sigma * np.sqrt(T_safe))
    d2 = d1 - sigma * np.sqrt(T_safe)

    n_d1 = norm.cdf(d1)
    n_d2 = norm.cdf(d2)
    pdf_d1 = norm.pdf(d1)

    if option_type.lower() == "call":
        price = S * n_d1 - K * np.exp(-r * T_safe) * n_d2
        delta = n_d1
        theta = (- (S * pdf_d1 * sigma) / (2 * np.sqrt(T_safe)) - r * K * np.exp(-r * T_safe) * n_d2) / 365.0
    elif option_type.lower() == "put":
        price = K * np.exp(-r * T_safe) * norm.cdf(-d2) - S * norm.cdf(-d1)
        delta = n_d1 - 1.0
        theta = (- (S * pdf_d1 * sigma) / (2 * np.sqrt(T_safe)) + r * K * np.exp(-r * T_safe) * norm.cdf(-d2)) / 365.0
    else:
        raise ValueError("option_type must be 'call' or 'put'")

    gamma = pdf_d1 / (S * sigma * np.sqrt(T_safe))
    vega = (S * np.sqrt(T_safe) * pdf_d1) / 100.0  # 1% vol move sensitivity

    return {
        "price": price,
        "delta": delta,
        "gamma": gamma,
        "vega": vega,
        "theta_daily": theta
    }

# =====================================================================
# 2. DISCRETE HEDGING TRACKING ERROR SIMULATION
# =====================================================================

def simulate_discrete_hedging_error(S0=120.0, K=120.0, r=0.045, sigma=0.35, T=0.25, steps=63, paths=1000):
    """
    Simulates discrete delta-hedging tracking error across Monte Carlo paths.
    Quantifies Gamma bleed under non-continuous rebalancing.
    """
    dt = T / steps
    np.random.seed(42)

    # Geometric Brownian Motion simulation
    increments = np.random.normal(loc=(r - 0.5 * sigma**2) * dt, scale=sigma * np.sqrt(dt), size=(paths, steps))
    log_paths = np.zeros((paths, steps + 1))
    log_paths[:, 1:] = np.cumsum(increments, axis=1)
    S_paths = S0 * np.exp(log_paths)

    time_grid = np.linspace(T, 1e-5, steps + 1)
    deltas = np.zeros((paths, steps))

    for t_idx in range(steps):
        res = vectorized_bs_greeks(S_paths[:, t_idx], K, time_grid[t_idx], r, sigma, "call")
        deltas[:, t_idx] = res["delta"]

    return S_paths, deltas

# =====================================================================
# 3. VISUALIZATION ENGINE
# =====================================================================

def generate_risk_profiles(S0=120.0, sigma=0.35, ticker="NVDA"):
    K = round(S0)
    r = 0.045
    times_to_expiry = [1.0, 0.5, 0.1, 0.01]
    S_range = np.linspace(S0 * 0.7, S0 * 1.3, 300)

    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 5))

    for T in times_to_expiry:
        metrics = vectorized_bs_greeks(S_range, K, T, r, sigma, "call")
        ax1.plot(S_range, metrics["delta"], label=f"T = {T}y")
        ax2.plot(S_range, metrics["gamma"], label=f"T = {T}y")

    ax1.axvline(x=K, color="red", linestyle="--", alpha=0.7, label=f"Strike ATM (K={K})")
    ax1.set_title(f"Delta Convergence ({ticker})", fontweight="bold")
    ax1.set_xlabel("Spot Price (S)")
    ax1.set_ylabel("Delta (Δ)")
    ax1.legend()
    ax1.grid(True, alpha=0.3)

    ax2.axvline(x=K, color="red", linestyle="--", alpha=0.7, label=f"Strike ATM (K={K})")
    ax2.set_title(f"Gamma Risk Profile (σ={sigma:.1%})", fontweight="bold")
    ax2.set_xlabel("Spot Price (S)")
    ax2.set_ylabel("Gamma (Γ)")
    ax2.legend()
    ax2.grid(True, alpha=0.3)

    plt.tight_layout()
    os.makedirs("plots", exist_ok=True)
    plt.savefig("plots/options_greeks_analysis.png", dpi=300)
    plt.close()
    print("Plots saved in plots/options_greeks_analysis.png")

if __name__ == "__main__":
    S0 = 120.0
    sigma_calibrated = 0.35
    generate_risk_profiles(S0, sigma_calibrated, "NVDA")
    paths, deltas = simulate_discrete_hedging_error(S0=S0, sigma=sigma_calibrated)
    print("Dynamic hedging error simulation completed successfully.")
